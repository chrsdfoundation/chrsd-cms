{
    "preset": "laravel",
    "exclude": [
        "bootstrap/cache",
        "storage",
        "vendor",
        "node_modules"
    ],
    "rules": {
        "concat_space": {
            "spacing": "one"
        },
        "no_unused_imports": true,
        "not_operator_with_successor_space": true,
        "phpdoc_align": false,
        "single_quote": true
    }
}
